  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#166d2a", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#630ac3", "fontStyle": "bold" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#147a32" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#390892" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#4e0899" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#340865", "fontStyle": "bold" }
    },
    {
      "scope": ["variable", "meta.definition.variable.name", "identifier"],
      "settings": { "foreground": "#090d17" }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#695073" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#630ac3" }
    },
    {
      "scope": ["entity.other.attribute-name", "support.type.property-name", "variable.other.property"],
      "settings": { "foreground": "#166d2a" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#340865", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#340865", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#166d2a", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#390892" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#b42332", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#390892",
    "type": { "foreground": "#340865", "bold": true },
    "class": { "foreground": "#340865", "bold": true },
    "enum": { "foreground": "#340865", "bold": true },
    "interface": { "foreground": "#340865", "bold": true },
    "struct": { "foreground": "#340865", "bold": true },
    "typeParameter": "#630ac3",
    "function": "#4e0899",
    "method": "#4e0899",
    "macro": "#630ac3",
    "variable": "#090d17",
    "variable.readonly": "#390892",
    "parameter": "#695073",
    "property": "#166d2a",
    "enumMember": "#390892",
    "event": "#630ac3",
    "keyword": { "foreground": "#630ac3", "bold": true },
    "modifier": "#630ac3",
    "comment": { "foreground": "#166d2a", "italic": true },
    "string": "#147a32",
    "number": "#390892",
    "regexp": "#166d2a",
    "operator": "#630ac3"
  }
}
