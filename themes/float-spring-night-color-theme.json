  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#78cd8d", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#c3aceb", "fontStyle": "bold" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#86eaa0" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#d8c2ff" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#e4d9f3" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#ad94f0", "fontStyle": "bold" }
    },
    {
      "scope": ["variable", "meta.definition.variable.name", "identifier"],
      "settings": { "foreground": "#f2eef7" }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#d4c8dc" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#c3aceb" }
    },
    {
      "scope": ["entity.other.attribute-name", "support.type.property-name", "variable.other.property"],
      "settings": { "foreground": "#86eaa0" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#e4d9f3", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#e4d9f3", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#86eaa0", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#d8c2ff" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff7b88", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#ad94f0",
    "type": { "foreground": "#ad94f0", "bold": true },
    "class": { "foreground": "#ad94f0", "bold": true },
    "enum": { "foreground": "#ad94f0", "bold": true },
    "interface": { "foreground": "#ad94f0", "bold": true },
    "struct": { "foreground": "#ad94f0", "bold": true },
    "typeParameter": "#c3aceb",
    "function": "#e4d9f3",
    "method": "#e4d9f3",
    "macro": "#c3aceb",
    "variable": "#f2eef7",
    "variable.readonly": "#d8c2ff",
    "parameter": "#d4c8dc",
    "property": "#86eaa0",
    "enumMember": "#d8c2ff",
    "event": "#c3aceb",
    "keyword": { "foreground": "#c3aceb", "bold": true },
    "modifier": "#c3aceb",
    "comment": { "foreground": "#78cd8d", "italic": true },
    "string": "#86eaa0",
    "number": "#d8c2ff",
    "regexp": "#86eaa0",
    "operator": "#c3aceb"
  }
}
